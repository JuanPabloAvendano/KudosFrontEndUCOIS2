# Copia este archivo como .env.local (Git lo ignora) y ajusta los valores.

# --- Servidor de Vite (no llegan al navegador) ---
KUDOS_BACKEND_URL=http://localhost:8080
KUDOS_GATEWAY_CABECERA=X-Kudos-Gateway
KUDOS_GATEWAY_SECRETO=

# --- Navegador ---
# «local» = token firmado en el navegador (sin Entra). Cualquier otro valor = login con Entra (MSAL).
VITE_MODO_AUTENTICACION=local

# Modo local
VITE_JWT_AUDIENCIA=api://kudos-local
# Pega aquí la llave privada de desarrollo (una sola línea, con \n donde van los saltos).
VITE_JWT_LOCAL_LLAVE_PRIVADA=

# Modo Entra (no son secretos: son identificadores públicos de la app)
# Vacío = «/api» (proxy de Vite). En producción: la URL de API Management terminada en /api.
VITE_API_URL=
VITE_ENTRA_AUTORIDAD=https://login.microsoftonline.com/<tenant-id>
VITE_ENTRA_CLIENTE=<client-id-de-kudos-front>
VITE_ENTRA_SCOPE=api://<client-id-de-kudos-api>/Kudos.Usar
# Igual a la redirect URI registrada en kudos-front (en local: http://localhost:5173).
VITE_ENTRA_REDIRECCION=http://localhost:5173
