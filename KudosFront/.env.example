# Copia este archivo como .env.local (Git lo ignora) y ajusta los valores.

# --- Servidor de Vite (no llegan al navegador) ---
KUDOS_BACKEND_URL=http://localhost:8080
KUDOS_GATEWAY_CABECERA=X-Kudos-Gateway
KUDOS_GATEWAY_SECRETO=el-mismo-valor-de-KUDOS_GATEWAY_SECRETO-en-el-back

# --- Navegador ---
VITE_MODO_AUTENTICACION=local
VITE_JWT_AUDIENCIA=api://kudos-local
# Pega aquí la llave privada de desarrollo (una sola línea, con \n donde van los saltos).
VITE_JWT_LOCAL_LLAVE_PRIVADA=
